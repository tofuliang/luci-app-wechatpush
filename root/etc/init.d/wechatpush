#!/bin/sh /etc/rc.common

START=99
STOP=90
USE_PROCD=1

dir="/tmp/wechatpush/"

start_service() {
    procd_open_instance
    enable_value=$(uci get wechatpush.config.enable 2>/dev/null || echo "0")
    [ "$enable_value" -ne "0" ] && procd_set_param command /usr/share/wechatpush/wechatpush && echo "wechatpush is starting now ..."
    procd_close_instance
}

reload_service() {
    enable_value=$(uci get wechatpush.config.enable 2>/dev/null || echo "0")
    [ "$enable_value" -ne 0 ] && skip_firewall_cleanup=1
    stop
    unset skip_firewall_cleanup
    sleep 1
    start
}


clear_forward_blacklist_rules() {
    if command -v fw4 >/dev/null 2>&1; then
        for set_name in wechatpush_blacklist wechatpush_blacklistv6; do
            nft --handle list chain inet fw4 forward 2>/dev/null | awk -v set_name="@$set_name" 'index($0, set_name " ") && / drop comment "!wechatpush Forward Drop rule"/ {print $NF}' | while read -r handle; do
                nft delete rule inet fw4 forward handle "$handle" >/dev/null 2>&1
            done
        done
    else
        for family in ip ip6; do
            case "$family" in
                ip) set_name=wechatpush_blacklist ;;
                ip6) set_name=wechatpush_blacklistv6 ;;
            esac
            while ${family}tables -C FORWARD -m set --match-set "$set_name" src -j DROP >/dev/null 2>&1; do
                ${family}tables -D FORWARD -m set --match-set "$set_name" src -j DROP >/dev/null 2>&1 || break
            done
        done
    fi
}

stop_service() {
    [ -f ${dir}child_pid ] && parent_pid=$(cat ${dir}child_pid)
    [ -n "$parent_pid" ] && {
        child_pids=$(pgrep -P $parent_pid)
        echo "Terminating child processes of wechatpush..."
        for child_pid in $child_pids; do
            kill $child_pid
        done
    }
	local helpers=$(ps | grep -E '/usr/libexec/wechatpush-call|\{wechatpush\}_[0-9]+' | grep -v grep | grep -v $$ | awk '{print $1}')
	[ -n "$helpers" ] && echo "$helpers" | xargs kill 2>/dev/null
    local pids=$(ps | grep '/usr/share/wechatpush/wechatpush' | grep -v grep | grep -v $$ | awk '{print $1}')
	[ -n "$pids" ] && echo "$pids" | xargs kill 2>/dev/null
    for pid in $pids; do
        attempts=0
        while kill -0 "$pid" 2>/dev/null; do
            if [ "$attempts" -ge 5 ]; then
                kill -KILL "$pid" 2>/dev/null
                break
            fi
            sleep 1
            attempts=$((attempts + 1))
        done
    done
    for pid in $helpers; do
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    done
	[ "$skip_firewall_cleanup" = "1" ] || clear_forward_blacklist_rules
    echo "Terminating wechatpush process..."
}

service_triggers() {
    procd_add_reload_trigger wechatpush
}
